#!/bin/sh
# Generated by zator internal/firewall (custom.d hook for zapret2).
# Client scopes: classify LAN clients by source IP before NAT using a private
# mark namespace. Reads client_scope.tsv ("mark:N<TAB>ip") at run time.
# Works with iptables (private chain in the mangle table) and nftables
# (private table, prerouting, priority -190). POSIX sh / busybox ash safe.

CLIENT_SCOPE_CHAIN="${CLIENT_SCOPE_CHAIN:-@@IPT_CHAIN@@}"
CLIENT_SCOPE_TABLE="${CLIENT_SCOPE_TABLE:-@@IPT_TABLE@@}"
CLIENT_SCOPE_NFT_TABLE=@@NFT_TABLE@@
CLIENT_SCOPE_NFT_CHAIN="${CLIENT_SCOPE_NFT_CHAIN:-@@NFT_CHAIN@@}"
CLIENT_SCOPE_COMMENT="${CLIENT_SCOPE_COMMENT:-@@COMMENT@@}"
CLIENT_SCOPE_MAP_FILE="${CLIENT_SCOPE_MAP_FILE:-@@MAP_FILE@@}"
CLIENT_SCOPE_MARK_SHIFT="${CLIENT_SCOPE_MARK_SHIFT:-@@SHIFT@@}"
CLIENT_SCOPE_MARK_MAX="${CLIENT_SCOPE_MARK_MAX:-@@MAX@@}"
CLIENT_SCOPE_MARK_MASK="${CLIENT_SCOPE_MARK_MASK:-@@MASK@@}"
zcs_tab="$(printf '\t')"

zcs_enabled() {
	[ "${CLIENT_SCOPE_ENABLE:-0}" = 1 ] || return 1
	# An empty/zero mask means "not configured" (same as locked.lua).
	[ -n "$CLIENT_SCOPE_MARK_MASK" ] && [ "$((CLIENT_SCOPE_MARK_MASK))" -ne 0 ] 2>/dev/null
}

zcs_valid_ipv4() {
	local o old="$IFS"
	case "$1" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
	IFS=.; set -- $1; IFS="$old"
	[ "$#" -eq 4 ] || return 1
	for o in "$@"; do
		case "$o" in ''|*[!0-9]*) return 1 ;; esac
		[ "${#o}" -le 3 ] && [ "$o" -le 255 ] || return 1
	done
	return 0
}

zcs_valid_ipv6() {
	case "$1" in ''|*[!0-9A-Fa-f:]*) return 1 ;; esac
	case "$1" in *:*) return 0 ;; esac
	return 1
}

# Prints the mark for scope id $1, fails when the id is invalid or does not
# fit in the configured mask.
zcs_mark_for_id() {
	local id="$1" mark
	case "$id" in ''|*[!0-9]*|0*) return 1 ;; esac
	[ "$id" -le "$CLIENT_SCOPE_MARK_MAX" ] 2>/dev/null || return 1
	mark=$((id << CLIENT_SCOPE_MARK_SHIFT))
	[ $((mark & ~CLIENT_SCOPE_MARK_MASK)) -eq 0 ] || return 1
	printf '%d\n' "$mark"
}

zcs_valid_nft_name() {
	case "$1" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_.-]*) return 1 ;; esac
	[ "${#1}" -le 32 ]
}

zcs_valid_comment() {
	local stripped
	stripped="$(printf '%s' "$1" | tr -d ' ')"
	case "$stripped" in ''|*[!A-Za-z0-9_.:/-]*) return 1 ;; esac
	[ "${#1}" -le 64 ]
}

# ---------------------------------------------------------------- iptables

zcs_ipt() {
	command -v iptables >/dev/null 2>&1 || return 127
	iptables -t "$CLIENT_SCOPE_TABLE" "$@"
}

zcs_ipt_comment_ok() {
	case "$CLIENT_SCOPE_COMMENT" in ''|*[!A-Za-z0-9_.:/-]*) return 1 ;; esac
	return 0
}

zcs_ipt_delete_owned() {
	local line rule n=0
	# Read only our chain. Never flush foreign state; every generated rule also
	# carries a stable comment as a second guard.
	zcs_ipt -S "$CLIENT_SCOPE_CHAIN" 2>/dev/null | while IFS= read -r line; do
		case "$line" in
		"-A $CLIENT_SCOPE_CHAIN "*"--comment $CLIENT_SCOPE_COMMENT"*|\
		"-A $CLIENT_SCOPE_CHAIN "*"--comment \"$CLIENT_SCOPE_COMMENT\""*)
			rule="${line#"-A $CLIENT_SCOPE_CHAIN "}"
			rule="$(printf '%s\n' "$rule" | sed "s/--comment \"$CLIENT_SCOPE_COMMENT\"/--comment $CLIENT_SCOPE_COMMENT/")"
			# shellcheck disable=SC2086 -- rule comes from iptables -S locally.
			zcs_ipt -D "$CLIENT_SCOPE_CHAIN" $rule || true ;;
		esac
	done
	while [ "$n" -lt 64 ] && zcs_ipt -C PREROUTING -m comment --comment "$CLIENT_SCOPE_COMMENT" -j "$CLIENT_SCOPE_CHAIN" 2>/dev/null; do
		zcs_ipt -D PREROUTING -m comment --comment "$CLIENT_SCOPE_COMMENT" -j "$CLIENT_SCOPE_CHAIN" || break
		n=$((n + 1))
	done
	return 0
}

zcs_iptables_apply() {
	local scope ip id mark
	zcs_enabled || return 0
	command -v iptables >/dev/null 2>&1 || return 0
	zcs_ipt_comment_ok || return 0
	[ -r "$CLIENT_SCOPE_MAP_FILE" ] || return 0
	zcs_ipt -N "$CLIENT_SCOPE_CHAIN" 2>/dev/null || true
	zcs_ipt_delete_owned
	# Insert FIRST in PREROUTING: policy-routing marks (magitrickle etc.) use the
	# full 32-bit mark (/0xffffffff) and overwrite whatever stood before them.
	zcs_ipt -I PREROUTING 1 -m comment --comment "$CLIENT_SCOPE_COMMENT" -j "$CLIENT_SCOPE_CHAIN" || return 1
	while IFS="$zcs_tab" read -r scope ip _ || [ -n "${scope:-}" ]; do
		case "$scope" in mark:*) id="${scope#mark:}" ;; *) continue ;; esac
		mark="$(zcs_mark_for_id "$id")" || continue
		zcs_valid_ipv4 "$ip" || continue
		zcs_ipt -A "$CLIENT_SCOPE_CHAIN" -s "$ip" -m comment --comment "$CLIENT_SCOPE_COMMENT" -j MARK --set-mark "$mark/$CLIENT_SCOPE_MARK_MASK" || return 1
	done < "$CLIENT_SCOPE_MAP_FILE"
	return 0
}

zcs_iptables_cleanup() {
	command -v iptables >/dev/null 2>&1 || return 0
	zcs_ipt_comment_ok || return 0
	zcs_ipt_delete_owned
	zcs_ipt -X "$CLIENT_SCOPE_CHAIN" 2>/dev/null || true
	return 0
}

# ---------------------------------------------------------------- nftables

zcs_nft_apply() {
	local tmp scope ip id mark family mask_clear rc
	zcs_enabled || return 0
	command -v nft >/dev/null 2>&1 || return 0
	zcs_valid_nft_name "$CLIENT_SCOPE_NFT_CHAIN" || return 0
	zcs_valid_comment "$CLIENT_SCOPE_COMMENT" || return 0
	[ -r "$CLIENT_SCOPE_MAP_FILE" ] || return 0
	mask_clear="$(printf '0x%08x' $((0xffffffff ^ CLIENT_SCOPE_MARK_MASK)))"
	tmp="${TMPDIR:-/tmp}/zator-client-scope-nft.$$.rules"
	{
		# One atomic transaction: create (no-op if present), drop, create again.
		printf 'add table inet %s\n' "$CLIENT_SCOPE_NFT_TABLE"
		printf 'delete table inet %s\n' "$CLIENT_SCOPE_NFT_TABLE"
		printf 'add table inet %s\n' "$CLIENT_SCOPE_NFT_TABLE"
		# Priority -190: after conntrack (-200) but BEFORE the standard mangle
		# zone (-150) where policy routing marks packets. Full-mark rewriters
		# win for their packets, the rest keep the client mark.
		printf 'add chain inet %s %s { type filter hook prerouting priority -190; policy accept; }\n' \
			"$CLIENT_SCOPE_NFT_TABLE" "$CLIENT_SCOPE_NFT_CHAIN"
		while IFS="$zcs_tab" read -r scope ip _ || [ -n "${scope:-}" ]; do
			case "$scope" in mark:*) id="${scope#mark:}" ;; *) continue ;; esac
			mark="$(zcs_mark_for_id "$id")" || continue
			if zcs_valid_ipv4 "$ip"; then family=ip; elif zcs_valid_ipv6 "$ip"; then family=ip6; else continue; fi
			printf 'add rule inet %s %s %s saddr %s meta mark set ((meta mark & %s) | %d) ct mark set meta mark comment "%s"\n' \
				"$CLIENT_SCOPE_NFT_TABLE" "$CLIENT_SCOPE_NFT_CHAIN" "$family" "$ip" "$mask_clear" "$mark" "$CLIENT_SCOPE_COMMENT"
		done < "$CLIENT_SCOPE_MAP_FILE"
	} > "$tmp"
	nft -f "$tmp"; rc=$?
	rm -f "$tmp"
	return "$rc"
}

zcs_nft_cleanup() {
	command -v nft >/dev/null 2>&1 || return 0
	# The table is private: delete only it.
	nft delete table inet "$CLIENT_SCOPE_NFT_TABLE" 2>/dev/null || true
	return 0
}

# ------------------------------------------------------ zapret2 custom.d API

# iptables: $1 = 1 (start) / 0 (stop)
zapret_custom_firewall() {
	[ "$FWTYPE" = iptables ] || return 0
	case "${1:-}" in
	1) zcs_iptables_apply ;;
	0) zcs_iptables_cleanup ;;
	*) return 1 ;;
	esac
}

zapret_custom_firewall_nft() {
	[ "$FWTYPE" = nftables ] || return 0
	zcs_nft_apply
}

zapret_custom_firewall_nft_flush() {
	zcs_nft_cleanup
}
