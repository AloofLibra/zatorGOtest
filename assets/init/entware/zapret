#!/bin/sh
### BEGIN INIT INFO
# Provides:		zapret
# Required-Start:	$local_fs $network
# Required-Stop:	$local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

SCRIPT=$(readlink -f "$0")
EXEDIR=$(dirname "$SCRIPT")
ZAPRET_BASE=$(readlink -f "$EXEDIR/../..")
# Keenetic/Entware: iptables/ipset живут в /opt/sbin — без PATH apply_fw молча ломается.
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
. "$EXEDIR/functions"

# z2r: оверрайды апстримных contains и run_daemon — см. AGENTS.md (High-Risk Areas).
contains()
{
	case "$1" in
		*"$2"*) return 0 ;;
	esac
	return 1
}

# z2r: оверрайд run_daemon — см. AGENTS.md (High-Risk Areas).
run_daemon()
{
	# $1 - daemon number : 1,2,3,...
	# $2 - daemon
	# $3 - daemon args
	local DAEMONBASE="$(basename "$2")"
	local PID= PIDFILE=$PIDDIR/${DAEMONBASE}_$1.pid
	echo "Starting daemon $1: $2 $3"

	[ -f "$PIDFILE" ] && {
		read PID <"$PIDFILE"
		[ -d "/proc/$PID" ] || PID=
	}

	if [ -n "$PID" ]; then
		echo already running
	else
		ERRLOG="/tmp/${DAEMONBASE}_$1.err"
		: > "$ERRLOG"
		if command -v setsid >/dev/null 2>&1; then
			setsid "$2" $3 </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
		elif [ -t 0 ]; then
			# job control даёт фону свою группу процессов (защита от Ctrl+C в
			# интерактивном меню), но требует ЖИВОЙ управляющий терминал:
			# под uhttpd/CGI с мёртвым pty (панель поднята nohup'ом из уже
			# закрытой SSH-сессии) busybox ash уходит в вечный спин на set -m
			set -m 2>/dev/null
			"$2" $3 </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
			set +m 2>/dev/null
		else
			"$2" $3 </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
		fi
		if [ -n "$PID" ]; then
			echo $PID >$PIDFILE
		else
			echo could not start daemon $1 : $2 $3
			false
		fi
	fi
}

NAME=zapret
DESC=anti-zapret

# Подтянуть ipset/xt_* модули Keenetic (без bitmap:port правила NFQUEUE не ставятся).
z2r_load_ko()
{
	local name="$1" path="/lib/modules/$(uname -r)/$1.ko"
	lsmod 2>/dev/null | grep -q "^${name} " && return 0
	[ -f "$path" ] || return 1
	insmod "$path" 2>/dev/null || return 1
	echo "$name.ko loaded"
	return 0
}

# Флаг для zator-nfqws-watchdog: пользователь хочет, чтобы nfqws2 был запущен.
Z2R_NFQWS_WANT_RUNNING="${Z2R_NFQWS_WANT_RUNNING:-/opt/zator/state/nfqws2.want_running}"

z2r_mark_want_running()
{
	mkdir -p "$(dirname "$Z2R_NFQWS_WANT_RUNNING")" 2>/dev/null || true
	echo 1 >"$Z2R_NFQWS_WANT_RUNNING" 2>/dev/null || true
}

z2r_clear_want_running()
{
	rm -f "$Z2R_NFQWS_WANT_RUNNING" 2>/dev/null || true
}

do_start()
{
	z2r_load_ko ip_set
	z2r_load_ko ip_set_bitmap_port
	z2r_load_ko ip_set_hash_ip
	z2r_load_ko ip_set_hash_net
	z2r_load_ko ip_set_hash_ipport
	z2r_load_ko xt_set

	if ! z2r_load_ko xt_multiport; then
		echo -e "\033[0;31mCannot find xt_multiport.ko kernel module, this make some problems. Or not.\033[0m"
	fi
	if ! z2r_load_ko xt_connbytes; then
		echo "Cannot find xt_connbytes.ko kernel module, aborting"
		exit 1
	fi
	if ! z2r_load_ko xt_NFQUEUE; then
		echo "Cannot find xt_NFQUEUE.ko kernel module, aborting"
		exit 1
	fi

	zapret_run_daemons
	z2r_mark_want_running
	[ "$INIT_APPLY_FW" != "1" ] || { zapret_apply_firewall; }
}
do_stop()
{
	z2r_clear_want_running
	zapret_stop_daemons
	[ "$INIT_APPLY_FW" != "1" ] || zapret_unapply_firewall
}

case "$1" in
	start)
		do_start
		;;

	stop)
		do_stop
		;;

	restart)
		do_stop
		do_start
		;;

	start-fw|start_fw)
		zapret_apply_firewall
		;;
	stop-fw|stop_fw)
		zapret_unapply_firewall
		;;

	restart-fw|restart_fw)
		zapret_unapply_firewall
		zapret_apply_firewall
		;;
	
	start-daemons|start_daemons)
		zapret_run_daemons
		z2r_mark_want_running
		;;
	stop-daemons|stop_daemons)
		z2r_clear_want_running
		zapret_stop_daemons
		;;
	restart-daemons|restart_daemons)
		zapret_stop_daemons
		zapret_run_daemons
		z2r_mark_want_running
		;;
	status)
		# Для service.Status fallback на Entware (pidof/proc предпочтительнее).
		if pidof nfqws2 >/dev/null 2>&1; then
			echo "zapret2 running"
			exit 0
		fi
		echo "zapret2 stopped"
		exit 3
		;;

	reload-ifsets|reload_ifsets)	
		zapret_reload_ifsets
		;;
	list-ifsets|list_ifsets)	
		zapret_list_ifsets
		;;
	list-table|list_table)	
		zapret_list_table
		;;
		
  *)
	N=/etc/init.d/$NAME
	echo "Usage: $N {start|stop|restart|status|start-fw|stop-fw|restart-fw|start-daemons|stop-daemons|restart-daemons|reload-ifsets|list-ifsets|list-table}" >&2
	exit 1
	;;
esac

exit 0
